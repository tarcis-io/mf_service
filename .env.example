# Example environment configuration for mf_service.
# Copy to `.env` and adjust. All variables are optional and default sensibly
# when unset. All variables use the MF_SERVICE_ prefix.

# HTTP server bind address and port.
MF_SERVICE_HOST=0.0.0.0
MF_SERVICE_PORT=8000

# Identity overrides (default to the installed package metadata).
# MF_SERVICE_NAME=mf_service
# MF_SERVICE_DESCRIPTION=MassFlow service: a FastAPI service exposing the MassFlow engine over HTTP.

# Firestore (batch storage). Leave the project blank on GCP (auto-detected from
# Application Default Credentials). The database defaults to Firestore's
# "(default)" database; set a name to target a named one. The collection
# defaults to "batches".
# MF_SERVICE_FIRESTORE_PROJECT=my-gcp-project
# MF_SERVICE_FIRESTORE_DATABASE=(default)
# MF_SERVICE_BATCHES_COLLECTION=batches

# Cloud Storage (batch file uploads). The bucket holds one folder per batch
# (<bucket>/<batch id>/<file>) and defaults to "batches". max_upload_bytes caps
# each uploaded file (default 10 MiB); a larger file is rejected with 413.
# MF_SERVICE_STORAGE_BUCKET=batches
# MF_SERVICE_MAX_UPLOAD_BYTES=10485760

# Processing. A batch stuck in an in-progress status longer than this (seconds)
# is timed out to "error" by POST /process/timeouts. Default 3600 (1 hour).
# MF_SERVICE_PROCESSING_TIMEOUT_SECONDS=3600
